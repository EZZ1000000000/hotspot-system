# =============================================
# .env.local - Environment Variables
# =============================================

# PostgreSQL Connection
# للتجربة المحلية:
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/hotspot_db"

# للـ VPS:
# DATABASE_URL="postgresql://user:password@your-server-ip:5432/hotspot_db"

# NextAuth
NEXTAUTH_SECRET="change-this-to-random-secret-string"
NEXTAUTH_URL="http://localhost:3000"

# Super Admin (للإعداد الأول)
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="changeme123"
SUPER_ADMIN_EMAIL="admin@yourdomain.com"

# Server URL (بيتحط في wifidog.conf)
NEXT_PUBLIC_SERVER_URL="http://YOUR_SERVER_IP:3000"

# ═══ الحماية من انهيار القواعد (db-cluster) ═══
# قواعد احتياطية مفصولة بفواصل — لو الأساسية ماتت النظام يقلب عليها لوحده
# (تقدر كمان تسجل قواعد احتياطية من لوحة السوبر أدمن من غير env)
# STANDBY_DB_URLS="postgresql://.../neondb?sslmode=require,postgresql://.../hotspot?sslmode=require"

# مفتاح السيرفر الحالي (لو الاستنتاج من الدومين مش كفاية: gamma|kappa|dun|seven)
# SERVER_KEY="gamma"

# سر الكرون/المزامنة (غيّره + ضبطه في GitHub Variables باسم DB_SYNC_SECRET)
CRON_SECRET="hotspot-cron-2024"
