{
  "name": "hotspot-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "if [ -n \"$DATABASE_URL\" ]; then prisma db push --skip-generate && node scripts/seed-runtime.js; fi && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "14.2.0",
    "react": "^18",
    "react-dom": "^18",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "next-auth": "^4.24.0",
    "node-ssh": "^13.2.0",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "prisma": "^5.0.0",
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/bcryptjs": "^2.4.6",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.0.1",
    "postcss": "^8"
  }
}